# ─── PhysicsTA v2 backend config (copy to .env) ──────────────────────────────

# Postgres + pgvector (the single datastore).
#   • docker-compose : postgresql+asyncpg://physicsta:physicsta@db:5432/physicsta
#   • local Postgres : postgresql+asyncpg://physicsta:physicsta@localhost:5432/physicsta
#   • Neon (hosted)  : paste Neon's string verbatim — db.py auto-adds +asyncpg and
#     handles ?sslmode=require/channel_binding for you, e.g.
#     postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://physicsta:physicsta@localhost:5432/physicsta

# Free LLM providers (both free tier)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Mistral OCR (free tier) — PRIMARY parser for scanned/physics PDFs when set:
# Markdown + LaTeX equations, fast (one cloud call), correct page numbers. Falls
# back to Docling/PyMuPDF if unset or it fails. Get a key at console.mistral.ai
MISTRAL_API_KEY=your_mistral_key_here

# Server (3001 matches the existing React frontend's Vite proxy target)
PORT=3001

# Local-only OCR fallback. false = fast PyMuPDF (digital text only); true = Docling
# (OCRs scans locally, slow on CPU, weaker on equations). Ignored when MISTRAL_API_KEY
# is set, since Mistral OCR is preferred.
USE_DOCLING=false

# ─── Optional overrides (defaults in app/config.py) ──────────────────────────
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_DIM=384
# RERANK_MODEL=BAAI/bge-reranker-base
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.1-flash-lite
# RERANK_GATE_PROB=0.30        # off-topic gate (tune against the eval harness)
# RERANK_KEEP_PROB=0.30        # keep chunks scoring at/above this
